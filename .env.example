# Copy to .env and fill in. Never commit .env.
COMPOSIO_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Any stable id for the throwaway test account, e.g. "connector-desk-test"
COMPOSIO_USER_ID=connector-desk-test
# Google Sheet id (the long id in the sheet URL). Use the sample sheet only.
SHEET_ID=
# Gmail label holding the partner emails
GMAIL_LABEL=connector-desk
STALE_DAYS=7
