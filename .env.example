# Copy to .env and fill in. Never commit .env.
COMPOSIO_API_KEY=
# Any stable id for the throwaway test account, e.g. "connector-desk-test"
COMPOSIO_USER_ID=connector-desk-test
# Google Sheet id (the long id in the sheet URL). Use the sample sheet only.
SHEET_ID=
# Gmail label holding the partner emails
GMAIL_LABEL=connector-desk
STALE_DAYS=7

# --- Model provider: pick ONE block ---
# openai_compatible: any OpenAI-style chat-completions API with tool calling.
#   OpenRouter (default base URL): set LLM_MODEL to an OpenRouter model id that supports tools.
#   Mistral: LLM_BASE_URL=https://api.mistral.ai/v1 and e.g. LLM_MODEL=mistral-small-latest
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# anthropic: set LLM_PROVIDER=anthropic and fill these instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
